"import.recommendation.description.anthropics_skills" = "Anthropic 官方 Skill 合集，覆盖文档处理、网页界面、Web 测试、Claude API、MCP Server、GIF 和视觉设计等多类能力。";
"import.recommendation.description.vercel_labs_agent_skills" = "Vercel 官方整理的前端开发 Skill 包，适合 React、Next.js、移动端和部署相关工作，让 AI 更懂现代前端工程实践。";
"import.recommendation.description.supabase_agent_skills" = "Supabase 官方数据库 Skill，适合 Postgres、Supabase、SQL 优化和权限设计，让 AI 给出更靠谱的数据库建议。";
"import.recommendation.description.shadcn_ui_ui" = "shadcn/ui 官方 Skill，帮助 AI 更懂 shadcn 组件体系和用法，适合现代 Web UI 开发。";
"import.recommendation.description.obra_superpowers" = "强调“先想清楚再开写”的开发工作流，适合容易被 AI 带偏、返工较多、项目容易失控的人。";
"import.recommendation.description.garrytan_gstack" = "把 AI 组织成“虚拟团队”的工作流仓库，适合需要计划、评审、QA、发布和复盘的开发者或产品团队。";
"import.recommendation.description.zarazhangrui_codebase_to_course" = "把代码库讲解成课程的 Skill，适合快速理解陌生项目、做新人 onboarding 或产出教学内容。";
"import.recommendation.description.jakubkrehel_make_interfaces_feel_better" = "这是一个专门提升 UI 细节质感的 Skill，适合做界面优化、视觉打磨和前端体验提升。";
"import.recommendation.description.pbakaus_impeccable" = "这是一个偏高标准设计审美的前端 Skill，适合想让 AI 产出的页面少一点模板味、多一点设计感的人。";
"import.recommendation.description.nextlevelbuilder_ui_ux_pro_max_skill" = "这是一个以 UI/UX 设计建议和设计系统生成为核心的 Skill，适合从产品需求快速走到界面规范的人。";
"import.recommendation.description.zanwei_design_dna" = "这是一个把参考设计风格拆成可复用规则的 Skill，适合做风格分析、设计迁移和视觉一致性整理。";
"import.recommendation.description.remotion_dev_skills" = "Remotion 官方 Skill 仓库，适合用代码做视频、动画和动态内容，也能让 AI 更懂 Remotion 的正确用法。";
"import.recommendation.description.jimliu_baoyu_skills" = "偏内容生产和发布自动化的中文 Skill 集，适合文章配图、封面图、信息图和社媒发布。";
"import.recommendation.description.zarazhangrui_frontend_slides" = "用前端方式生成高质量演示文稿的 Skill，适合做 HTML Slides、在线展示和 PPT 转网页。";
"import.recommendation.description.coreyhaines31_marketingskills" = "非常完整的营销 Skill 合集，适合增长、文案、SEO、转化优化和 SaaS 营销。";
"import.recommendation.description.dontbesilent2025_dbskill" = "中文商业分析 Skill 包，适合商业诊断、内容分析、对标研究和增长思考。";
"import.recommendation.description.mvanhorn_last30days_skill" = "专门看“最近 30 天发生了什么”的研究 Skill，适合趋势追踪、舆情观察和热点分析。";
"import.recommendation.description.lijigang_ljg_skills" = "很有中文特色的知识工作流 Skill 包，适合学习、写作、论文阅读、概念拆解和旅行研究。";
"import.recommendation.description.kepano_obsidian_skills" = "面向 Obsidian 用户的 Skill 集，适合笔记、知识管理、Markdown 工作流和 Obsidian 插件相关场景。";
"import.recommendation.description.vercel_labs_agent_browser" = "让 AI 能像人一样操作浏览器，适合网页测试、自动填表、抓取网页内容和自动化检查。";
"import.recommendation.description.joeseesun_opencli_skill" = "让 AI 直接操作 B 站、知乎、X、YouTube 等网站的 Skill，适合内容创作者和多平台运营。";
