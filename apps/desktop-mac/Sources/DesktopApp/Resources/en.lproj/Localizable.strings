"import.recommendation.description.vercel_labs_agent_skills" = "Vercel's official frontend skill pack fits React, Next.js, mobile, and deployment work, and helps AI understand modern frontend engineering practices better.";
"import.recommendation.description.supabase_agent_skills" = "Supabase's official database skill fits Postgres, Supabase, SQL optimization, and permission design, and helps AI give more reliable database guidance.";
