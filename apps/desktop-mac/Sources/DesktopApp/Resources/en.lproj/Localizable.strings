"import.recommendation.description.jakubkrehel_make_interfaces_feel_better" = "This skill is focused on improving UI detail quality, and is a good fit for interface refinement, visual polish, and frontend experience upgrades.";
"import.recommendation.description.pbakaus_impeccable" = "This frontend skill leans toward a higher design bar and stronger aesthetic standards, and fits people who want AI-generated pages to feel less templated and more designed.";
"import.recommendation.description.nextlevelbuilder_ui_ux_pro_max_skill" = "This skill centers on UI and UX recommendations plus design-system generation, and is useful for moving quickly from product requirements to interface conventions.";
"import.recommendation.description.zanwei_design_dna" = "This skill breaks reference design styles into reusable rules, which makes it useful for style analysis, design migration, and visual consistency work.";
"import.recommendation.description.remotion_dev_skills" = "Remotion's official skill repository fits video, animation, and dynamic content made with code, and helps AI use Remotion the right way.";
"import.recommendation.description.jimliu_baoyu_skills" = "A Chinese skill set focused on content production and publishing automation, suited for article visuals, covers, infographics, and social posting.";
"import.recommendation.description.zarazhangrui_frontend_slides" = "A skill for generating high-quality presentations in a frontend-native way, suited for HTML slides, online presentations, and turning PPT into web pages.";
"import.recommendation.description.coreyhaines31_marketingskills" = "A very complete marketing skill collection suited for growth, copywriting, SEO, conversion optimization, and SaaS marketing.";
"import.recommendation.description.dontbesilent2025_dbskill" = "A Chinese business-analysis skill pack suited for business diagnosis, content analysis, competitive research, and growth thinking.";
"import.recommendation.description.mvanhorn_last30days_skill" = "A research skill focused on what happened in the last 30 days, suited for trend tracking, sentiment watching, and hot-topic analysis.";
"import.recommendation.description.lijigang_ljg_skills" = "A distinctly Chinese knowledge-workflow skill pack suited for learning, writing, paper reading, concept breakdown, and travel research.";
"import.recommendation.description.kepano_obsidian_skills" = "A skill collection for Obsidian users, suited for note-taking, knowledge management, markdown workflows, and Obsidian plugin-related work.";
"import.recommendation.description.vercel_labs_agent_browser" = "Lets AI operate a browser like a person, suited for web testing, auto-filling forms, scraping web content, and automation checks.";
"import.recommendation.description.joeseesun_opencli_skill" = "Lets AI directly operate sites like Bilibili, Zhihu, X, and YouTube, suited for content creators and multi-platform operators.";
