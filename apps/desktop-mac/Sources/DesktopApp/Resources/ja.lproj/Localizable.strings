"import.recommendation.description.anthropics_skills" = "Anthropic 公式の Skill 集で、文書処理、Web UI、Web テスト、Claude API、MCP Server、GIF、ビジュアルデザインなど幅広い能力をカバーします。";
"import.recommendation.description.vercel_labs_agent_skills" = "Vercel 公式のフロントエンド Skill パックで、React、Next.js、モバイル、デプロイ関連の作業に向いており、AI が現代的なフロントエンド実務をより理解しやすくなります。";
"import.recommendation.description.supabase_agent_skills" = "Supabase 公式のデータベース Skill で、Postgres、Supabase、SQL 最適化、権限設計に向いており、AI がより信頼できるデータベース助言をしやすくなります。";
"import.recommendation.description.shadcn_ui_ui" = "shadcn/ui 公式 Skill で、AI が shadcn のコンポーネント体系や使い方をより理解できるようになり、モダンな Web UI 開発に向いています。";
"import.recommendation.description.obra_superpowers" = "書き始める前にまず考えを整理することを重視した開発ワークフローで、AI に振り回されやすい人、手戻りが多い人、プロジェクトが制御しづらくなりがちな人に向いています。";
"import.recommendation.description.garrytan_gstack" = "AI を仮想チームとして組織するワークフロー用リポジトリで、計画、レビュー、QA、リリース、振り返りが必要な開発者やプロダクトチームに向いています。";
"import.recommendation.description.zarazhangrui_codebase_to_course" = "コードベースをコースのように解説する Skill で、見慣れないプロジェクトをすばやく理解したい人、新人 onboarding、教育コンテンツ作成に向いています。";
"import.recommendation.description.jakubkrehel_make_interfaces_feel_better" = "UI の細部の質感を高めることに特化した Skill で、画面改善、ビジュアルの磨き込み、フロントエンド体験の向上に向いています。";
"import.recommendation.description.pbakaus_impeccable" = "より高いデザイン基準と審美眼を持つフロントエンド Skill で、AI が出すページをテンプレートっぽさ少なめで、もっとデザイン感のあるものにしたい人に向いています。";
"import.recommendation.description.nextlevelbuilder_ui_ux_pro_max_skill" = "UI/UX の提案とデザインシステム生成を中心にした Skill で、プロダクト要件から画面規範までを素早くつなぎたい人に向いています。";
"import.recommendation.description.zanwei_design_dna" = "参考デザインのスタイルを再利用可能なルールに分解する Skill で、スタイル分析、デザイン移行、ビジュアル一貫性の整理に向いています。";
"import.recommendation.description.remotion_dev_skills" = "Remotion 公式の Skill リポジトリで、コードで動画、アニメーション、動的コンテンツを作る用途に向いており、AI が Remotion の正しい使い方を理解しやすくなります。";
"import.recommendation.description.jimliu_baoyu_skills" = "コンテンツ制作と配信自動化に寄った中国語 Skill 集で、記事用画像、カバー画像、インフォグラフィック、SNS 投稿に向いています。";
"import.recommendation.description.zarazhangrui_frontend_slides" = "フロントエンド方式で高品質なプレゼン資料を作る Skill で、HTML Slides、オンライン展示、PPT の Web 化に向いています。";
"import.recommendation.description.coreyhaines31_marketingskills" = "非常に充実したマーケティング Skill 集で、グロース、コピー、SEO、CV 最適化、SaaS マーケティングに向いています。";
"import.recommendation.description.dontbesilent2025_dbskill" = "中国語のビジネス分析 Skill パックで、事業診断、コンテンツ分析、競合研究、グロース思考に向いています。";
"import.recommendation.description.mvanhorn_last30days_skill" = "直近 30 日で何が起きたかを見ることに特化した研究 Skill で、トレンド追跡、世論観測、ホットトピック分析に向いています。";
"import.recommendation.description.lijigang_ljg_skills" = "中国語らしい知識ワークフロー Skill パックで、学習、執筆、論文読解、概念分解、旅行調査に向いています。";
"import.recommendation.description.kepano_obsidian_skills" = "Obsidian ユーザー向けの Skill 集で、メモ、知識管理、Markdown ワークフロー、Obsidian プラグイン関連の作業に向いています。";
"import.recommendation.description.vercel_labs_agent_browser" = "AI が人のようにブラウザを操作できるようにし、Web テスト、自動フォーム入力、Web コンテンツ取得、自動化チェックに向いています。";
"import.recommendation.description.joeseesun_opencli_skill" = "AI が Bilibili、Zhihu、X、YouTube などのサイトを直接操作できる Skill で、コンテンツ制作者やマルチプラットフォーム運用に向いています。";
